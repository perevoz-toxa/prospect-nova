{
  "defaultProvider": "strata",
  "defaultModel": "swift-1.5-iq2_xs",
  "defaultThinkingLevel": "high",
  "defaultTools": ["read", "bash", "edit", "write", "grep", "find", "ls"],
  "sessionDir": "./.pi/sessions",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 40000
  },
  "prompts": ["./prompts"]
}
